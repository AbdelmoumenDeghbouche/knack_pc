        <ID>CUSA00068</ID>
        <ID>CUSA00006</ID>
        <ID>CUSA00004</ID>
    </TitleID>
    <Metadata Title="Knack" Name="Cheat - God Mode" Note="Knack takes no damage." Author="Web Xx" PatchVer="1.0" AppVer="01.10" AppElf="eboot.bin" isEnabled="false">
        <PatchList>
