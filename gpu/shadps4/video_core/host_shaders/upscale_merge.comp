// bbport: writes the upscaler's color back into the game's scene color, keeping the game's alpha
// (post-processing reads data from it). Mode 1 (debug) shows the reactive mask in red instead.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D upscaled;
layout(binding = 1, rgba16f) uniform image2D scene;
layout(binding = 2, r8) uniform readonly image2D reactive;

layout(push_constant) uniform Params {
    uint mode;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(scene)))) {
        return;
    }
    const vec4 original = imageLoad(scene, pixel);
    vec3 color = imageLoad(upscaled, pixel).rgb;
    if (mode == 1) {
        const float mask = imageLoad(reactive, pixel).r;
        color = mix(color * 0.25, vec3(4.0, 0.0, 0.0), mask);
    }
    imageStore(scene, pixel, vec4(color, original.a));
}
